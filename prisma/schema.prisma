// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Band {
  Id                             Int      @id @default(autoincrement())
  es_id                          String
  name                           String
  origin                         String
  officialWebsite                String
  rockAndRollHallOfFameInduction Int?
  albums                         Album[]
  artists                        Artist[]
  bandGenres                     BandGenre[]
}

model Album {
  Id            Int           @id @default(autoincrement())
  BandId        Int
  title         String
  year          Int
  lengthMinutes String
  band          Band          @relation(fields: [BandId], references: [Id])
  albumSongs    AlbumSong[]
  albumArtists  AlbumArtist[]
}

model Song {
  Id          Int         @id @default(autoincrement())
  title       String
  year        Int
  achievement String
  hit         Boolean
  albumSongs  AlbumSong[]
}

model AlbumSong {
  albumId     Int   @map("album_id")
  songId      Int   @map("song_id")
  trackNumber Int   @map("track_number")
  album       Album @relation(fields: [albumId], references: [Id], onDelete: Cascade)
  song        Song  @relation(fields: [songId], references: [Id], onDelete: Cascade)

  @@id([albumId, songId])
  @@map("album_songs")
}

model Artist {
  Id                Int                @id @default(autoincrement())
  es_id             String             @default("")
  name              String
  birthdate         DateTime
  BandId            Int
  band              Band               @relation(fields: [BandId], references: [Id])
  albumArtists      AlbumArtist[]
  artistInstruments ArtistInstrument[]
}

model AlbumArtist {
  albumId  Int    @map("album_id")
  artistId Int    @map("artist_id")
  album    Album  @relation(fields: [albumId], references: [Id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [Id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@map("album_artists")
}

model Instrument {
  Id                Int                @id @default(autoincrement())
  name              String
  Type              String
  artistInstruments ArtistInstrument[]
}

model Genre {
  Id         Int         @id @default(autoincrement())
  name       String
  mainGenre  String?     @map("main_genre")
  bandGenres BandGenre[]
}

model BandGenre {
  bandId  Int    @map("band_id")
  genreId Int    @map("genre_id")
  band    Band   @relation(fields: [bandId], references: [Id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [Id], onDelete: Cascade)

  @@id([bandId, genreId])
  @@map("band_genre")
}

model ArtistInstrument {
  artistId     Int        @map("artist_id")
  instrumentId Int        @map("instrument_id")
  artist       Artist     @relation(fields: [artistId], references: [Id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [Id], onDelete: Cascade)

  @@id([artistId, instrumentId])
  @@map("artist_instruments")
}
